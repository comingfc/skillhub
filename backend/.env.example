# SkillHub Backend Environment Variables
# Copy this to .env and fill in your values

# Database (PostgreSQL)
DATABASE_URL=postgresql://skillhub:skillhub_secret@192.168.33.40:5432/skillhub

# Redis
REDIS_URL=redis://192.168.33.40:6379/0

# S3/MinIO Storage
S3_ENDPOINT=http://192.168.33.40:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=skillhub
S3_REGION=us-east-1

# JWT Authentication
JWT_SECRET=change_me_use_secure_random_256bit
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth (optional - for GitHub/Google login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
